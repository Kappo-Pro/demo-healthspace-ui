/**
 * CommandPalette Styles
 *
 * Clean, modern command palette with smooth animations
 * Following UX spec transition timing and motion principles
 */

.commandPaletteModal :global(.ant-modal-content) {
  padding: 0;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: var(--shadow-lg);
}

.commandPalette {
  display: flex;
  flex-direction: column;
  background: var(--modal-bg, var(--surface-primary));
  max-height: 600px;
}

/* Search Container */
.searchContainer {
  display: flex;
  align-items: center;
  padding: 16px 20px;
  gap: 12px;
  border-bottom: 1px solid var(--border-default, var(--color-gray-200));
  background: var(--surface-primary, var(--surface-primary));
}

.searchIcon {
  font-size: 18px;
  color: var(--text-tertiary, var(--color-gray-400));
}

.searchInput {
  flex: 1;
  font-size: 16px;
  background: transparent !important;
  color: var(--text-primary, var(--color-gray-900));
}

.searchInput::placeholder {
  color: var(--text-placeholder, var(--color-gray-400));
}

.searchInput:focus {
  box-shadow: none !important;
}

/* Command List */
.commandList {
  overflow-y: auto;
  max-height: 400px;
  padding: 8px;
}

/* Palette Content */
.paletteContent {
  flex: 1;
  overflow-y: auto;
  overflow-x: hidden;
  min-height: 200px;
}

.commandsList {
  padding: 8px;
}

.commandList::-webkit-scrollbar {
  width: 8px;
}

.commandList::-webkit-scrollbar-track {
  background: transparent;
}

.commandList::-webkit-scrollbar-thumb {
  background: var(--border-default, var(--color-gray-200));
  border-radius: 4px;
}

.commandList::-webkit-scrollbar-thumb:hover {
  background: var(--border-strong, var(--color-gray-300));
}

/* Command Group */
.commandGroup {
  margin-bottom: 8px;
}

.commandGroup:last-child {
  margin-bottom: 0;
}

.groupHeader {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 8px 12px 4px;
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--text-tertiary, var(--color-gray-500));
}

/* Command Item */
.commandItem {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 12px;
  border-radius: 6px;
  cursor: pointer;
  transition: background-color 150ms ease-out, transform 100ms ease-out;
  user-select: none;
}

.commandItem:hover {
  background-color: var(--sidebar-item-hover-bg, var(--nav-hover-bg, var(--color-gray-100)));
}

.commandItem.selected {
  background-color: var(--sidebar-item-active-bg, var(--surface-brand));
}

.commandItem:active {
  transform: scale(0.98);
}

.commandIcon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border-radius: 6px;
  background: var(--surface-secondary, var(--color-gray-50));
  color: var(--text-secondary, var(--color-gray-500));
  font-size: 16px;
  flex-shrink: 0;
}

.commandItem.selected .commandIcon {
  background: var(--brand-primary);
  color: var(--text-on-brand);
  transition: background-color 150ms ease-out, color 150ms ease-out;
}

.commandContent {
  flex: 1;
  min-width: 0;
}

.commandLabel {
  font-size: 14px;
  font-weight: 500;
  color: var(--text-primary, var(--color-gray-900));
  line-height: 1.4;
}

.commandDescription {
  font-size: 12px;
  color: var(--text-tertiary, var(--color-gray-500));
  line-height: 1.3;
  margin-top: 2px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* No Results */
.noResults {
  padding: 40px 20px;
  text-align: center;
  color: var(--text-tertiary, var(--color-gray-500));
  font-size: 14px;
}

/* No Match Suggestion */
.noMatchSuggestion {
  position: absolute;
  bottom: -28px;
  left: 44px;
  font-size: 12px;
  color: var(--text-secondary, var(--color-gray-600));
  white-space: nowrap;
}

.noMatchSuggestion strong {
  color: var(--brand-primary);
  font-weight: 600;
}

/* Placeholder */
.placeholder {
  padding: 40px 20px;
  text-align: center;
  color: var(--text-tertiary, var(--color-gray-500));
  font-size: 14px;
}

/* User Context Header */
.userContextHeader {
  padding: 16px 20px;
  border-bottom: 1px solid var(--border-default, var(--color-gray-200));
  background: var(--surface-secondary, var(--color-gray-50));
  animation: slideDown 200ms cubic-bezier(0.4, 0, 0.2, 1);
}

.userAvatar {
  background: var(--brand-primary);
  color: var(--text-on-brand);
  font-weight: 600;
  flex-shrink: 0;
}

.userName {
  font-size: 16px;
  line-height: 1.4;
}

.roleBadge {
  display: inline-flex;
  align-items: center;
  padding: 2px 8px;
  border-radius: 4px;
  font-size: 11px;
  font-weight: 600;
  color: var(--text-on-brand);
  text-transform: uppercase;
  letter-spacing: 0.03em;
}

.lastLogin {
  font-size: 12px;
}

.clearUserButton {
  color: var(--text-tertiary, var(--color-gray-400));
  flex-shrink: 0;
}

.clearUserButton:hover {
  color: var(--color-error-600);
  background: var(--color-error-50);
}

/* Loading State */
.loadingState {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60px 20px;
  gap: 16px;
}

.loadingMessage {
  font-size: 14px;
  color: var(--text-secondary, var(--color-gray-600));
}

/* Empty State */
.emptyState {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60px 20px;
  text-align: center;
}

.emptyIcon {
  font-size: 48px;
  color: var(--text-tertiary, var(--color-gray-300));
  margin-bottom: 16px;
}

.emptyTitle {
  font-size: 16px;
  font-weight: 600;
  color: var(--text-primary, var(--color-gray-900));
  margin-bottom: 8px;
}

.emptyMessage {
  font-size: 14px;
  color: var(--text-secondary, var(--color-gray-600));
  max-width: 300px;
}

/* User Search Results */
.userResultsList {
  padding: 8px;
}

.userResultItem {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px;
  border-radius: 6px;
  cursor: pointer;
  transition: background-color 150ms ease-out;
  user-select: none;
}

.userResultItem:hover {
  background-color: var(--sidebar-item-hover-bg, var(--nav-hover-bg, var(--color-gray-100)));
}

.userResultItem.selected {
  background-color: var(--sidebar-item-active-bg, var(--surface-brand));
}

.userResultAvatar {
  flex-shrink: 0;
}

.userResultContent {
  flex: 1;
  min-width: 0;
}

.userResultName {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 14px;
  font-weight: 600;
  color: var(--text-primary, var(--color-gray-900));
  line-height: 1.4;
}

.userResultRole {
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.03em;
}

.userResultMeta {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  color: var(--text-secondary, var(--color-gray-600));
  margin-top: 2px;
}

.userResultEmail {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.userResultStatus {
  text-transform: capitalize;
  font-weight: 500;
}

.userResultLastLogin {
  white-space: nowrap;
}

.separator {
  color: var(--text-tertiary, var(--color-gray-400));
}

/* Footer */
.footer {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 12px 20px;
  border-top: 1px solid var(--border-default, var(--color-gray-200));
  background: var(--surface-secondary, var(--color-gray-50));
}

.footerHint {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  color: var(--text-tertiary, var(--color-gray-500));
}

/* Keyboard Badge */
.kbd {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 24px;
  height: 20px;
  padding: 0 6px;
  border-radius: 4px;
  background: var(--surface-tertiary, var(--color-gray-100));
  border: 1px solid var(--border-subtle, var(--color-gray-200));
  font-size: 11px;
  font-family: 'SF Mono', 'Monaco', 'Inconsolata', 'Roboto Mono', monospace;
  font-weight: 500;
  color: var(--text-secondary, var(--color-gray-500));
  box-shadow: var(--shadow-xs);
  flex-shrink: 0;
}

/* Locked Tag (USER role) */
.lockedTag {
  position: absolute;
  right: 50px;
  top: 50%;
  transform: translateY(-50%);
  font-size: 11px;
  padding: 2px 8px;
  display: flex;
  align-items: center;
  gap: 4px;
}

/* Animations */
@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.commandPaletteModal :global(.ant-modal-content) {
  animation: slideDown 200ms cubic-bezier(0.4, 0, 0.2, 1);
}

/* Reduced Motion Support */
@media (prefers-reduced-motion: reduce) {
  .commandItem,
  .commandIcon,
  .commandPaletteModal :global(.ant-modal-content) {
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
  }

  .commandItem.selected {
    transform: none;
  }

  .commandItem:active {
    transform: none;
  }
}

/* Dark Theme Support */
@media (prefers-color-scheme: dark) {
  .commandPaletteModal :global(.ant-modal-content) {
    background: var(--modal-bg, var(--color-gray-800));
  }

  .commandPalette {
    background: var(--modal-bg, var(--color-gray-800));
  }

  .searchContainer {
    background: var(--surface-primary, var(--color-gray-900));
    border-bottom-color: var(--border-default, var(--color-gray-700));
  }

  .searchInput {
    color: var(--text-primary, var(--color-gray-50));
  }

  .commandItem:hover {
    background-color: var(--sidebar-item-hover-bg, var(--surface-interactive-hover));
  }

  .commandItem.selected {
    background-color: var(--sidebar-item-active-bg, var(--surface-brand));
  }

  .footer {
    background: var(--surface-secondary, var(--color-gray-900));
    border-top-color: var(--border-default, var(--color-gray-700));
  }

  .kbd {
    background: var(--surface-tertiary, var(--color-gray-700));
    border-color: var(--border-subtle, var(--color-gray-600));
    color: var(--text-secondary, var(--color-gray-300));
  }
}

/* ===================================
   EPIC 4: USER ACTIONS & DRAWER
   =================================== */

/* User Actions List */
.actionsList {
  padding: 12px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.noActions {
  padding: 60px 20px;
  text-align: center;
  color: var(--text-tertiary, var(--color-gray-400));
  font-size: 14px;
}

/* Action Card */
.actionCard {
  position: relative;
  border: 1px solid var(--border-default);
  border-radius: 8px;
  padding: 16px;
  cursor: pointer;
  transition: all 200ms cubic-bezier(0.4, 0, 0.2, 1);
  user-select: none;
  background: var(--surface-primary);
}

.actionCard:hover {
  border-color: var(--brand-primary);
  box-shadow: var(--shadow-sm);
  transform: translateY(-1px);
}

.actionCard.selected {
  border-color: var(--brand-primary);
  background: var(--sidebar-item-active-bg, var(--surface-brand));
}

.actionCard.dangerAction {
  border-color: var(--border-error);
}

.actionCard.dangerAction:hover {
  border-color: var(--border-error);
  box-shadow: var(--shadow-sm);
}

.actionCard.dangerAction.selected {
  background: var(--surface-error);
  border-color: var(--border-error);
}

.selectedIndicator {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 3px;
  background: var(--brand-primary);
  border-radius: 8px 0 0 8px;
}

.actionIcon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48px;
  height: 48px;
  border-radius: 8px;
  background: var(--surface-secondary, var(--color-gray-50));
  color: var(--text-secondary, var(--color-gray-600));
  font-size: 20px;
  flex-shrink: 0;
  transition: all 200ms ease-out;
}

.actionCard:hover .actionIcon {
  background: var(--brand-primary-light);
  color: var(--brand-primary);
}

.actionCard.dangerAction .actionIcon {
  background: var(--surface-error);
  color: var(--text-error);
}

.actionDescription {
  font-size: 13px;
  line-height: 1.5;
}

.shortcutKbd {
  margin-left: 8px;
  padding: 2px 6px;
  background: var(--surface-tertiary, var(--color-gray-100));
  border: 1px solid var(--border-subtle, var(--color-gray-200));
  border-radius: 4px;
  font-size: 10px;
  font-weight: normal;
  font-family: 'SF Mono', 'Monaco', 'Inconsolata', 'Roboto Mono', monospace;
}

/* Palette Drawer */
.paletteDrawer {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  background: var(--surface-primary);
  border-left: 1px solid var(--border-default);
  display: flex;
  flex-direction: column;
  animation: slideInRight 300ms cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: var(--shadow-md);
}

@keyframes slideInRight {
  from {
    transform: translateX(100%);
    opacity: 0;
  }
  to {
    transform: translateX(0);
    opacity: 1;
  }
}

.drawerHeader {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px;
  border-bottom: 1px solid var(--border-default, var(--color-gray-200));
  flex-shrink: 0;
}

.drawerBody {
  flex: 1;
  overflow-y: auto;
  padding: 16px;
}

.drawerBody::-webkit-scrollbar {
  width: 8px;
}

.drawerBody::-webkit-scrollbar-track {
  background: transparent;
}

.drawerBody::-webkit-scrollbar-thumb {
  background: var(--border-default, var(--color-gray-200));
  border-radius: 4px;
}

.drawerBody::-webkit-scrollbar-thumb:hover {
  background: var(--border-strong, var(--color-gray-300));
}

/* Dark Theme Support for Actions & Drawer */
@media (prefers-color-scheme: dark) {
  .actionCard {
    background: var(--surface-primary, var(--color-gray-800));
    border-color: var(--border-default, var(--color-gray-700));
  }

  .actionCard:hover {
    border-color: var(--brand-primary);
    box-shadow: var(--shadow-md);
  }

  .actionCard.selected {
    background: var(--sidebar-item-active-bg, var(--surface-brand));
  }

  .actionIcon {
    background: var(--surface-secondary);
  }

  .actionCard:hover .actionIcon {
    background: var(--brand-primary);
    color: var(--text-on-brand);
  }

  .paletteDrawer {
    background: var(--surface-primary, var(--color-gray-800));
    border-left-color: var(--border-default, var(--color-gray-700));
  }

  .drawerHeader {
    border-bottom-color: var(--border-default, var(--color-gray-700));
  }
}

/* ===================================
   EPIC 5: POLISH & PERFORMANCE
   =================================== */

/* Performance Optimizations */
.commandPaletteModal :global(.ant-modal-content) {
  will-change: transform, opacity;
}

.commandPalette {
  will-change: height;
}

.commandItem.selected,
.actionCard:hover {
  will-change: transform;
}

.paletteDrawer {
  will-change: transform, opacity;
}

/* Enhanced Modal Transitions */
.commandPaletteModal {
  --ease-out: cubic-bezier(0.4, 0, 0.2, 1);
  --ease-in-out: cubic-bezier(0.4, 0, 0.6, 1);
  --ease-spring: cubic-bezier(0.68, -0.55, 0.265, 1.55);
}

/* Fade In Animation for Content */
@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* Scale In Animation for Cards */
@keyframes scaleIn {
  from {
    opacity: 0;
    transform: scale(0.95);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

/* Slide Up Animation */
@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Apply Staggered Animations */
.commandItem,
.userResultItem,
.actionCard {
  animation: slideUp 200ms var(--ease-out) both;
}

.commandItem:nth-child(1) { animation-delay: 0ms; }
.commandItem:nth-child(2) { animation-delay: 30ms; }
.commandItem:nth-child(3) { animation-delay: 60ms; }
.commandItem:nth-child(4) { animation-delay: 90ms; }
.commandItem:nth-child(5) { animation-delay: 120ms; }

.userResultItem:nth-child(1) { animation-delay: 0ms; }
.userResultItem:nth-child(2) { animation-delay: 30ms; }
.userResultItem:nth-child(3) { animation-delay: 30ms; }
.userResultItem:nth-child(4) { animation-delay: 60ms; }
.userResultItem:nth-child(5) { animation-delay: 90ms; }

.actionCard:nth-child(1) { animation-delay: 0ms; }
.actionCard:nth-child(2) { animation-delay: 40ms; }
.actionCard:nth-child(3) { animation-delay: 80ms; }
.actionCard:nth-child(4) { animation-delay: 120ms; }

/* Loading State Animation */
.loadingState {
  animation: fadeIn 300ms var(--ease-out);
}

/* Empty State Animation */
.emptyState {
  animation: scaleIn 400ms var(--ease-out);
}

/* Footer Slide Up */
.footer {
  animation: slideUp 250ms var(--ease-out) 100ms both;
}

/* User Context Header Refined */
.userContextHeader {
  animation: slideDown 250ms var(--ease-out) both;
}

/* Drawer Slide Animation Enhancement */
.paletteDrawer {
  animation: slideInRight 350ms var(--ease-out) both;
}

/* Micro-interactions */
.commandItem:active,
.actionCard:active,
.userResultItem:active {
  transform: scale(0.98);
}

.kbd:active {
  transform: scale(0.95);
  box-shadow: none;
}

/* Smooth Scroll Behavior */
.paletteContent,
.commandList,
.drawerBody {
  scroll-behavior: smooth;
}


/* Hover Glow Effect */
.actionCard:hover {
  box-shadow: var(--shadow-sm);
  outline: 1px solid var(--brand-primary);
  outline-offset: -1px;
}

/* Loading Spinner Custom Animation */
:global(.ant-spin) {
  animation: fadeIn 200ms ease-out;
}

/* Backdrop Blur for Modal */
.commandPaletteModal :global(.ant-modal-mask) {
  backdrop-filter: blur(var(--blur-sm));
  background-color: var(--modal-overlay);
}

/* GPU Acceleration Hints */
.commandPalette,
.paletteDrawer,
.commandItem,
.actionCard,
.userResultItem {
  -webkit-backface-visibility: hidden;
  backface-visibility: hidden;
  -webkit-perspective: 1000;
  perspective: 1000;
}

/* Reduced Motion Overrides for Epic 5 */
@media (prefers-reduced-motion: reduce) {
  .commandItem,
  .userResultItem,
  .actionCard,
  .loadingState,
  .emptyState,
  .footer,
  .userContextHeader,
  .paletteDrawer {
    animation: none !important;
    animation-delay: 0ms !important;
  }

  .commandItem:active,
  .actionCard:active,
  .userResultItem:active,
  .kbd:active {
    transform: none;
  }

  .commandPaletteModal :global(.ant-modal-mask) {
    backdrop-filter: none;
  }
}

/* ===================================
   PHASE 3: PROGRAM CONTEXT
   =================================== */

.programContextContent {
  display: flex;
  flex-direction: column;
  max-height: 450px;
}

.programHeader {
  padding: 12px 16px;
  border-bottom: 1px solid var(--border-default, var(--color-gray-200));
  display: flex;
  flex-direction: column;
  gap: 4px;
  background: var(--surface-secondary, var(--color-gray-50));
  flex-shrink: 0;
}

.categoryHeader {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  font-weight: 600;
  color: var(--text-tertiary, var(--color-gray-500));
  padding: 8px 12px 4px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.categoryHeader svg {
  font-size: 14px;
}
