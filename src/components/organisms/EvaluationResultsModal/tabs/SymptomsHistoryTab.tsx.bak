`;

const ComorbidityStatus = styled.span`
	font-size: var(--font-size-sm);
	color: var(--text-secondary);
`;

const ContraindicationsList = styled.div`
	display: flex;
	flex-direction: column;
	gap: var(--spacing-2);
`;

const ContraindicationItem = styled.div<{ severity: string }>`
	display: flex;
	flex-direction: column;
	gap: var(--spacing-1);
	padding: var(--spacing-2);
	background: var(--color-background-primary);
	border-radius: var(--radius-sm);
	border-left: 4px solid
