{
	"compilerOptions": {
		"allowJs": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"strict": true,
		"forceConsistentCasingInFileNames": true,
		"noFallthroughCasesInSwitch": true,
		"target": "esnext",
		"module": "esnext",
		"moduleResolution": "node",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"jsx": "react-jsx",
		"lib": ["ESNext", "DOM", "WebWorker"],
		"baseUrl": "./",
		"paths": {
			"@atoms/*": ["./src/components/atoms/*"],
			"@molecules/*": ["./src/components/molecules/*"],
			"@organisms/*": ["./src/components/organisms/*"],
			"@pages/*": ["./src/components/pages/*"],
			"@templates/*": ["./src/components/templates/*"],
			"@vitalflow-icons/*": ["./src/icons/*"],
			"@controller/*": ["./src/poseestimator/controller/*"],
			"@assets": ["./src/poseestimator/assets/*"],
			"@performance/*": ["./src/poseestimator/performance/*"],
			"@rom/*": ["./src/poseestimator/rom/*"],
			"@rehab/*": ["./src/poseestimator/rehab/*"],
			"@services/*": ["./src/services/*"],
			"@stores/*": ["./src/stores/*"],
			"@screens/*": ["./src/screens/*"],
			"@common/*": ["./src/common/*"],
			"@utils/*": ["./src/utils/*"],
			"@strapi": ["./src/Strapi.ts"],
			"@routers/*": ["./src/routers/*"],
			"@hooks/*": ["./src/hooks/*"],
			"@contexts/*": ["./src/contexts/*"],
			"@constants/*": ["./src/constants/*"],
			"@styles/*": ["./src/styles/*"],
			"@config/*": ["./src/config/*"],
			"@components/*": ["./src/components/*"],
			"@providers/*": ["./src/providers/*"],
			"@test-utils": ["./src/test-utils"],
			"@test-utils/*": ["./src/test-utils/*"],
			"@types": ["./src/types"],
			"@types/*": ["./src/types/*"],
			"@sdk/*": ["./src/sdk/*"],
			"@demo/*": ["./src/demo/*"],
			"@workers/*": ["./src/workers/*"]
		}
	},
	"include": ["src/**/*"],
	"exclude": [
		"node_modules",
		"**/*.spec.ts",
		"dist",
		"public",
		"zoom",
		"build",
		"./node_modules",
		"./node_modules/*",
		"BKP",
		"./BKP",
		"./BKP/*"
	]
}
